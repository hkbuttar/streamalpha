# Alpaca paper account (same account as alpha-signal-lab), used here for the
# real-time trade/quote WebSocket stream instead of the REST API.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Data feed tier for the WebSocket stream: "iex" (free/paper default) or "sip"
# (paid, requires an upgraded plan). Paper accounts are normally IEX-only.
ALPACA_DATA_FEED=iex

# Your plan caps how many symbols you can subscribe to at once (Alpaca
# returns error 405 "symbol limit exceeded" over the cap). Alpaca doesn't
# publish the exact number, so find yours empirically: lower this until the
# stream connects, then use that value. Leave unset to try the full universe.
ALPACA_MAX_SYMBOLS=30

# Local Kafka broker (see docker-compose.yml). Point this at your managed
# Kafka provider's bootstrap servers once this is deployed.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Consumer group id for streaming/consumer.py. Optional -- defaults to
# streamalpha-consumers in code if unset.
KAFKA_CONSUMER_GROUP=

# Tumbling window size (seconds) for per-ticker volume/volatility
# aggregation in streaming/run_consumer.py. Optional -- defaults to 10.
ANOMALY_WINDOW_SECONDS=

# Where streaming/run_consumer.py persists per-ticker model state (pickle)
# between restarts. Optional -- defaults to model_state.pkl in the cwd.
MODEL_STATE_PATH=

# Postgres connection string for the anomalies schema, same DATABASE_URL
# convention as alpha-signal-lab. Use a separate database from
# alpha-signal-lab's, not the same one. For local dev, docker-compose's
# postgres service matches this (port 5433, not 5432 -- see
# docker-compose.yml for why):
# postgresql://streamalpha:streamalpha@localhost:5433/streamalpha
DATABASE_URL=

# Consumer group id for storage/sink.py. Optional -- defaults to
# streamalpha-storage-sink in code if unset.
STORAGE_CONSUMER_GROUP=

# Comma-separated origins allowed to call the FastAPI backend (backend/main.py).
# Defaults to "*" if unset.
ALLOWED_ORIGINS=
